import tkinter as tk
from tkinter import messagebox
import random
import time

# Hlavní okno
root = tk.Tk()
root.title("Random Tkinter App")
root.geometry("500x400")
root.configure(bg="#1e1e2e")

score = 0

# Funkce pro random barvu
def random_color():
    colors = [
        "#ff4d4d", "#4dff88", "#4da6ff",
        "#ffd24d", "#bf80ff", "#ff66b3"
    ]
    return random.choice(colors)

# Klikací funkce
def click_me():
    global score
    score += 1
    score_label.config(text=f"Score: {score}")

    # Random pozice tlačítka
    x = random.randint(50, 350)
    y = random.randint(100, 300)

    button.place(x=x, y=y)

    # Random barva
    button.config(bg=random_color())

# Čas
def update_time():
    current = time.strftime("%H:%M:%S")
    time_label.config(text=current)
    root.after(1000, update_time)

# Meme text
memes = [
    "Bro really clicked 💀",
    "Tkinter GOAT",
    "Python moment",
    "Spam harder 😎",
    "Cookie Clicker vibes"
]

def random_meme():
    meme_label.config(text=random.choice(memes))

# Nadpis
title = tk.Label(
    root,
    text="🔥 Random Tkinter Game 🔥",
    font=("Arial", 20, "bold"),
    fg="white",
    bg="#1e1e2e"
)
title.pack(pady=10)

# Score
score_label = tk.Label(
    root,
    text="Score: 0",
    font=("Arial", 16),
    fg="cyan",
    bg="#1e1e2e"
)
score_label.pack()

# Čas
time_label = tk.Label(
    root,
    font=("Arial", 14),
    fg="lime",
    bg="#1e1e2e"
)
time_label.pack(pady=5)

# Meme label
meme_label = tk.Label(
    root,
    text="Klikni tlačítko 😎",
    font=("Arial", 12),
    fg="orange",
    bg="#1e1e2e"
)
meme_label.pack(pady=10)

# Random tlačítko
button = tk.Button(
    root,
    text="KLIKNI MĚ",
    font=("Arial", 14, "bold"),
    bg="red",
    fg="white",
    command=lambda: [click_me(), random_meme()]
)

button.place(x=180, y=180)

# Exit button
exit_btn = tk.Button(
    root,
    text="EXIT",
    font=("Arial", 12),
    bg="black",
    fg="red",
    command=root.destroy
)
exit_btn.pack(side="bottom", pady=15)

# Start času
update_time()

root.mainloop()