class Auto:
    """
    Třída reprezentující automobil pro ukázku Objektově Orientovaného Programování (OOP).
    """
    def __init__(self, znacka, model, nadrz_kapacita):
        self.znacka = znacka              # Veřejný atribut
        self.model = model                # Veřejný atribut
        self._nadrz_objem = 0             # Chráněný atribut (zapouzdření)
        self._max_nadrz = nadrz_kapacita  # Maximální kapacita nádrže

    def natankovat(self, litry):
        if litry < 0:
            print(f"[{self.znacka}] Chyba: Nemůžeš odčerpat palivo!")
        elif self._nadrz_objem + litry > self._max_nadrz:
            self._nadrz_objem = self._max_nadrz
            print(f"[{self.znacka}] Nádrž je plná! Natankováno na maximum ({self._max_nadrz}l).")
        else:
            self._nadrz_objem += litry
            print(f"[{self.znacka}] Úspěšně natankováno {litry}l. V nádrži je teď {self._nadrz_objem}l.")

    def jed(self, vzdalenost):
        spotreba = vzdalenost * 0.07
        if self._nadrz_objem >= spotreba:
            self._nadrz_objem -= spotreba
            print(f"[{self.znacka} {self.model}] ujel {vzdalenost} km. V nádrži zbývá {self._nadrz_objem:.1f}l.")
        else:
            print(f"[{self.znacka}] Chyba: Nedostatek paliva!")

# --- HLAVNÍ ČÁST PROGRAMU ---
if __name__ == "__main__":
    moje_auto = Auto("Skoda", "Octavia", 50)
    moje_auto.natankovat(30)
    moje_auto.jed(100)
 